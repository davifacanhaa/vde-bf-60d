# Webhook/endpoint que recebe o lead via POST JSON:
# { nome, whatsapp, email, origem: "captura-bf-60d" }
# Se vazio, o formulário apenas mostra o estado de sucesso (modo protótipo).
NEXT_PUBLIC_LEAD_ENDPOINT=

# Opcional: URL para redirecionar após a inscrição (ex.: grupo do WhatsApp)
NEXT_PUBLIC_REDIRECT_URL=
